{
    "name": "php-io-extensions/appkit",
    "type": "php-ext",
    "description": "1:1 PHP bindings of AppKit and the CoreFoundation run loop it runs on, as classes named after their native counterparts",
    "keywords": [
        "appkit",
        "macos",
        "cocoa",
        "gui",
        "run-loop",
        "php-ext"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Project Saturn Studios, LLC",
            "email": "info@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        }
    },
    "php-ext": {
        "extension-name": "appkit",
        "priority": 30,
        "support-zts": true,
        "support-nts": true,
        "os-families": [
            "darwin"
        ],
        "configure-options": [
            {
                "name": "enable-appkit",
                "description": "Enable the appkit extension",
                "needs-value": false
            }
        ]
    }
}
