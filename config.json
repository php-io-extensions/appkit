    "extra-libs": "-framework Foundation -framework AppKit -framework CoreGraphics -framework CoreImage -framework UniformTypeIdentifiers",
    "stubs": {
        "path": "ide/%version%/%namespace%/",
        "stubs-run-after-generate": false
