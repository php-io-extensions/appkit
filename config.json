{
    "namespace": "appkit",
    "name": "appkit",
    "extension-name": "appkit",
    "description": "AppKit bound 1:1 into PHP",
    "author": "Project Saturn Studios, LLC",
    "version": "0.9.0",
    "extra-sources": [
        "src/ns-bridge.m",
        "src/ns-button.m",
        "src/ns-application.m",
        "src/ns-window.m",
        "src/ns-menuitem.m",
        "src/ns-menu.m",
        "src/ns-view.m",
        "src/ns-responder.m",
        "src/ns-control.m",
        "src/ns-cell.m",
        "src/ns-textfield.m",
        "src/ns-textfieldcell.m",
        "src/ns-securetextfield.m",
        "src/ns-switch.m",
        "src/ns-slider.m",
        "src/ns-slidercell.m",
        "src/ns-progressindicator.m",
        "src/ns-popupbutton.m",
        "src/ns-combobox.m",
        "src/ns-comboboxcell.m",
        "src/ns-datepicker.m",
        "src/ns-datepickercell.m",
        "src/ns-colorwell.m",
        "src/ns-segmentedcontrol.m",
        "src/ns-segmentedcell.m",
        "src/ns-stepper.m",
        "src/ns-steppercell.m",
        "src/ns-pathcontrol.m",
        "src/ns-pathcontrolitem.m",
        "src/ns-pathcell.m",
        "src/ns-pathcomponentcell.m",
        "src/ns-searchfield.m",
        "src/ns-searchfieldcell.m",
        "src/ns-alert.m",
        "src/ns-savepanel.m",
        "src/ns-openpanel.m",
        "src/ns-toolbar.m",
        "src/ns-toolbaritem.m",
        "src/ns-toolbaritemgroup.m",
        "src/ns-statusbar.m",
        "src/ns-statusitem.m",
        "src/ns-statusbarbutton.m",
        "src/ns-image.m",
        "src/ns-imagerep.m",
        "src/ns-imageview.m",
        "src/ns-text.m",
        "src/ns-textview.m",
        "src/ns-textcontainer.m",
        "src/ns-layoutmanager.m",
        "src/ns-scrollview.m",
        "src/ns-clipview.m",
        "src/ns-textstorage.m",
        "src/ns-popover.m",
        "src/ns-splitview.m",
        "src/ns-stackview.m",
        "src/ns-box.m",
        "src/ns-visualeffectview.m",
        "src/ns-tabview.m",
        "src/ns-viewcontroller.m",
        "src/ns-tabviewitem.m",
        "src/ns-tableview.m",
        "src/ns-outlineview.m",
        "src/ns-collectionview.m",
        "src/ns-collectionviewlayout.m",
        "src/ns-collectionviewflowlayout.m",
        "src/ns-collectionviewgridlayout.m",
        "src/ns-gridview.m",
        "src/ns-tablecolumn.m",
        "src/ns-tablecellview.m",
        "src/ns-tablerowview.m",
        "src/ns-tableheaderview.m",
        "src/ns-tableheadercell.m",
        "src/ns-font.m",
        "src/ns-fontdescriptor.m",
        "src/ns-color.m",
        "src/ns-event.m",
        "src/ca-layer.m",
        "src/ns-screen.m",
        "src/ns-notificationcenter.m"
    ],
    "optimizer-dirs": [
        "optimizers"
    ],
    "extra-cflags": "-fobjc-arc -Wno-deprecated-declarations",
    "extra-libs": "-framework Foundation -framework AppKit -framework QuartzCore -framework CoreImage -framework Symbols",
    "stubs": {
        "path": "ide/%version%/%namespace%/",
        "stubs-run-after-generate": false
    },
    "warnings": {
        "unused-variable": true,
        "unused-variable-external": true,
        "possible-wrong-parameter": true,
        "possible-wrong-parameter-undefined": true,
        "nonexistent-function": true,
        "nonexistent-class": true
    },
    "optimizations": {
        "call-gatherer-pass": true,
        "check-invalid-reads": true,
        "constant-folding": true,
        "local-context-pass": true,
        "static-constant-class-folding": true,
        "static-type-inference": true,
        "static-type-inference-second-pass": true
    }
}
